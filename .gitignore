# Elementor Starter Kit - .gitignore

# WordPress Core Files
# (if developing inside WordPress installation)
/wp-admin/
/wp-includes/
/wp-content/*
!/wp-content/plugins/
/wp-content/plugins/*
!/wp-content/plugins/elementor-starter-kit/

# WordPress Config
wp-config.php
wp-config-sample.php

# Database
*.sql
*.sql.gz
*.sqlite

# Log Files
*.log
error_log
debug.log

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Editor and IDE Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.settings/
.buildpath

# Backup Files
*.bak
*.backup
*~

# Temporary Files
*.tmp
*.temp

# Node Modules (if using npm/yarn)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Composer (if using PHP dependencies)
/vendor/
composer.lock

# Build Files
/dist/
/build/
*.min.css
*.min.js
*.map

# Compiled Translation Files
languages/*.mo

# Plugin ZIP Files
*.zip

# Testing
/tests/
phpunit.xml
.phpunit.result.cache

# Cache Directories
.cache/
cache/

# Environment Files
.env
.env.local
.env.*.local

# Deployment Files
deploy.sh
.ftpconfig
.deployignore

# Documentation Build
/docs/_build/

# macOS
.AppleDouble
.LSOverride

# Windows
desktop.ini

# Linux
.directory

# Logs and Databases
*.log
*.sql
*.sqlite

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Output of 'npm pack'
*.tgz

# dotenv environment variables file
.env

# IDE - VSCode
.history/

# Misc
.sass-cache/
*.css.map
*.sass.map
*.scss.map
complete-package-summary
